# AdMob app IDs (Google AdMob app settings)
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=

# AdMob rewarded ad unit IDs (separate Android and iOS units)
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_ID=
EXPO_PUBLIC_ADMOB_IOS_REWARDED_ID=

# RevenueCat public SDK keys (never put secret API keys in the app)
EXPO_PUBLIC_RC_GOOGLE_KEY=
EXPO_PUBLIC_RC_APPLE_KEY=

# Deployed HTTPS backend for weekly leaderboard
EXPO_PUBLIC_API_URL=
